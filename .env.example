# Atlas passkeys demo — copy to .env.local and fill in your instance's values.

# Publishable key (safe to expose to the browser).
NEXT_PUBLIC_ATLAS_PUBLISHABLE_KEY=pk_test_xxx

# The instance's Frontend API origin.
NEXT_PUBLIC_ATLAS_FRONTEND_API=https://atlasauth.net

# Edge JWT verification (proxy.ts + server auth()).
ATLAS_JWKS_URL=https://atlasauth.net/.well-known/jwks.json
ATLAS_ISSUER=https://atlasauth.net
